{
  "compilerOptions": {
    "target": "ES2022",
    // Les types de `@playwright/test` (via playwright-core) referencing des
    // globals DOM (HTMLElement, SVGElement...), la lib DOM est requise des que
    // `tests/e2e` est inclu ici.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "playwright.config.ts", "tests/e2e"]
}
